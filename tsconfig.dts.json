{
  "include": [
    "node_modules/bc-stubs/bc/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
  ],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowJs": false,
    "removeComments": false,
    "alwaysStrict": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "jsxImportSource": "tsx-dom",
    "baseUrl": "src",
    "rootDir": "src",
    "outDir": "dist/types",
  },
}