{
  "include": [
    "node_modules/bc-stubs/bc/**/*.d.ts",
    "src/**/*.js",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/zois-core.mjs",
    "tests/toastsManager.test.ts",
    "tests/messagesManager.test.ts",
    "tests/dialogsManager.test.ts",
    "tests/setup.ts"
  ],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "allowJs": false,
    "removeComments": true,
    "skipLibCheck": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "tsx-dom",
    "rootDir": "./",
    "outDir": "dist",
  },
}